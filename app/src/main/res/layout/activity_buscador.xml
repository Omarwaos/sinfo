<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:orientation="vertical"
    android:padding="25dp"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Buscador">

    <TextView
        android:layout_marginBottom="15dp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:textSize="20dp"
        android:text="Busque un Alumno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <EditText
            android:inputType="number"
            android:id="@+id/edtIDBsc"
            android:hint="Ingrese la ID"
            android:background="@drawable/rounded_rectangle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"/>

        <Button
            android:id="@+id/btnBuscar"
            android:layout_marginLeft="10dp"
            android:textSize="15dp"
            android:text="Buscar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

    </LinearLayout>

    <EditText
        android:inputType="text"
        android:id="@+id/edtApellidosBsc"
        android:hint="Apellidos"
        android:layout_marginTop="20dp"
        android:background="@drawable/rounded_rectangle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        />

    <EditText
        android:inputType="text"
        android:id="@+id/edtNombresBsc"
        android:hint="Nombres"
        android:layout_marginTop="10dp"
        android:background="@drawable/rounded_rectangle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        />
    <EditText
        android:inputType="phone"
        android:id="@+id/edtTelefonoBsc"
        android:hint="Teléfono"
        android:layout_marginTop="10dp"
        android:background="@drawable/rounded_rectangle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        />
    <EditText
        android:inputType="text"
        android:id="@+id/edtDireccionBsc"
        android:hint="Dirección"
        android:layout_marginTop="10dp"
        android:background="@drawable/rounded_rectangle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        />
    <EditText
        android:inputType="textEmailAddress"
        android:id="@+id/edtEmailBsc"
        android:hint="Email"
        android:layout_marginTop="10dp"
        android:background="@drawable/rounded_rectangle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        />


    <Button
        android:id="@+id/btnEliminar"
        android:textSize="18dp"
        android:layout_marginTop="25dp"
        android:text="Eliminar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btnActualizar"
        android:textSize="18dp"
        android:text="Actualizar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btnReiniciar"
        android:textSize="18dp"
        android:text="Reiniciar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>


</LinearLayout>